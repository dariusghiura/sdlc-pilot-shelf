{
  "$description": "Design tokens (W3C DTCG format). Values come only from the approved design brief and previews; mark unknowns in $extensions.sdlc.open_questions, never guess.",
  "$extensions": {
    "sdlc": {
      "id": "TOKENS",
      "status": "draft",
      "version": "0.1.0",
      "based_on": { "DESIGN-BRIEF": "0.0.0" },
      "approved_by": "",
      "approved_on": "",
      "open_questions": []
    }
  },
  "color": {
    "$type": "color",
    "palette": {
      "neutral-0": { "$value": "#ffffff" },
      "neutral-900": { "$value": "#1a1a1a" }
    }
  },
  "theme": {
    "light": {
      "surface": { "$type": "color", "default": { "$value": "{color.palette.neutral-0}" } },
      "text": { "$type": "color", "primary": { "$value": "{color.palette.neutral-900}" } }
    },
    "dark": {
      "surface": { "$type": "color", "default": { "$value": "{color.palette.neutral-900}" } },
      "text": { "$type": "color", "primary": { "$value": "{color.palette.neutral-0}" } }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": { "$value": ["system-ui", "sans-serif"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" }
  },
  "motion": {
    "$type": "duration",
    "fast": { "$value": "120ms" }
  }
}
